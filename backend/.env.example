NODE_ENV=development
PORT=5000
# JSON/form request limit. Large booking item payloads need more than the old 20kb cap.
REQUEST_BODY_LIMIT=2mb
CLIENT_URL=http://localhost:3000
# Comma-separated extra browser origins for admin, website, and monitoring deployments.
# Example: https://www.example.com,https://admin.example.com,https://monitor.example.com
CLIENT_URLS=http://localhost:3001,http://localhost:3002
# Optional absolute backend URL used by the Socket.IO monitoring self-probes.
MONITORING_SELF_URL=http://127.0.0.1:5000
MONGO_URI=mongodb://127.0.0.1:27017/tithi_packers

# Used only once when the database has no admin account.
DEFAULT_ADMIN_NAME=Tithi Admin
DEFAULT_ADMIN_EMAIL=tithi@packerandmovers.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_DAYS=7
# Use none only for cross-site HTTPS admin/backend deployments.
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_EXPOSE_BEARER_TOKEN=false

# console for local development; msg91 or twilio for real SMS.
SMS_PROVIDER=console
OTP_VERIFICATION_WINDOW_MINUTES=15
BOOKING_REQUIRE_OTP=true

# Recommended India OTP provider configuration.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Optional Twilio fallback configuration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API stays off until Meta Business/template approval is complete.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
META_WHATSAPP_API_VERSION=v22.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_BOOKING_CONFIRMED_TEMPLATE=tithi_booking_confirmed
WHATSAPP_STATUS_UPDATE_TEMPLATE=tithi_booking_status_update
REDIS_URL=redis://127.0.0.1:6379
