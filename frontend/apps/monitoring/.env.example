# Backend origin only. Frontend API modules append /api themselves.
NEXT_PUBLIC_API_URL=https://your-backend-domain.com

# Optional. Enable Maps JavaScript, Places, Geocoding, and Directions APIs.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Public business phone used in structured data. Example format: +91-XXXXXXXXXX
NEXT_PUBLIC_BUSINESS_PHONE=

# Optional. Enables booking tracking synthetic probe in monitoring. Leave blank unless a safe test booking/mobile exists.
NEXT_PUBLIC_MONITORING_TRACKING_PROBE_MOBILE=
