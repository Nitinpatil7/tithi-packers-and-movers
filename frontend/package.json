{
  "name": "tithi-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:website && npm run build:admin && npm run build:monitoring",
    "build:website": "npm --prefix apps/website run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:monitoring": "npm --prefix apps/monitoring run build",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@tanstack/react-query": "^5.101.1",
    "axios": "^1.18.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "next": "^16.3.2",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.9.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
